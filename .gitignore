!_update_charts_data.py
!_update_recycling_charts.py
!_update_wti_ur_data.py
!validate_before_deploy.py
!no_cache_server.py
!server_service.py
!optimize_html.py
!protect_html.py
!calibrate_html.py

# 排除大文件（>5MB，妙搭限制）
embedded/inline_02.js

# 工具脚本（已使用，不需要跟踪）
batch_optimize.py
check_large_files.py
compress_js.py


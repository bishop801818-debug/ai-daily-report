# ==========================================
# AI Daily Report - Git Ignore Rules
# 整理后目录结构：
#  根目录 = 仅保留核心网站文件 (~87个)
#   _archive/ = 历史存档（按类别分子目录）
#   _docs/    = 设计文档
#   data/     = 大型数据JSON
#   embedded/ = 嵌入版文件
#   reports/  = 早报JSON存档
#   scripts/  = 工具脚本
# ==========================================

# ------------------------------------------
# 1. Python 开发脚本（仅保留核心脚本）
# ------------------------------------------
*.py
!generate_all_embedded_data.py
!generate_electrolyte_data.py
!safe_rollback.py
!generate_briefing.py
!generate_briefing_v2.py
!generate_hot_news.py
!import_all.py
!_gen_carbonate_embedded.py
!_update_charts_data.py
!_update_recycling_charts.py
!_update_wti_ur_data.py
!validate_before_deploy.py
!no_cache_server.py
!server_service.py
!optimize_html.py
!protect_html.py
!calibrate_html.py

# 排除大文件（>5MB，妙搭限制）
embedded/inline_02.js

# 工具脚本（已使用，不需要跟踪）
batch_optimize.py
check_large_files.py
compress_js.py

# ------------------------------------------
# 2. 调试/临时文件（覆盖下划线开头）
# ------------------------------------------
_*
!_docs/
!_docs/*
!_sources/
!_sources/*
debug_*
test_*
diag_*
check_*
fix_*
__test*
tmp/
temp/
*.tmp

# ------------------------------------------
# 3.备份文件（通配）
# ------------------------------------------
*.bak
*.bak_*
*_bak_*
*_backup_*
*_olden_*
*_stable_*
*_stable_latest*
*_golden_*

# ------------------------------------------
# 4. 大型数据文件（可从Excel重新生成）
# ------------------------------------------
# 排除临时文件
data/*_temp.json
data/*_bak.json
data/*_old.json
data/*_backup.json
data/*.csv
!data/README.md


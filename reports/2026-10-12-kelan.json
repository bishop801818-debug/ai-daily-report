    {
      "dim": "enterprise",
      "title": "企业动态",
      "items": [
        {
          "title": "尿素企业库存下降，出口发运加快",
          "content": "截至2026年9月23日，中国尿素企业总库存量147.57万吨，较上周期下降8.05万吨，环比下降5.17%。主要因外围区域出口发运节奏加快，库存由厂库端转移至港口端，且临近假期下游阶段性跟进。",
          "priority": "P1",
          "source": "隆众资讯，2026-10-09",
          "url": "",
          "date": "2026-10-09"
        },
        {
          "title": "尿素开工率维持高位，日产重回20万吨上方",
          "content": "当前尿素开工率维持高位，9月初多套装置集中检修带动日产短暂回落，月中后检修装置陆续复产、日均产量重回20万吨上方，高供应格局尚未根本改变，整体货源仍显充裕。",
          "priority": "P1",
          "source": "大越期货，2026-10-09",
          "url": "",
          "date": "2026-10-09"
        },
        {
          "title": "港口库存大幅去化，压力有所缓解",
          "content": "上一轮印标船期已至、出口货源集中离港，港口库存自103万吨大幅去化至55万吨，压力有所缓解，价格低位运行，主流煤制固定床利润亏损收窄但仍承压。",
          "priority": "P1",
          "source": "大越期货，2026-10-09",
          "url": "",
          "date": "2026-10-09"
        }
      ]

      "dim": "policy",
      "title": "政策/行业",
      "items": [
        {
          "title": "尿素行业强监管，政策覆盖多维",
          "content": "尿素行业属强监管行业，政策覆盖产业准入、能耗管控、生态环保、农资市场管理、粮食配套等维度。严控新增产能，双碳政策倒逼节能降碳改造，环保法规持续收紧，环保合规能力成为企业生存底线。",
          "priority": "P1",
          "source": "中研网，2026-10-09",
          "url": "",
          "date": "2026-10-09"
        },
        {
          "title": "农资市场监管体系完善，打击假冒伪劣",
          "content": "农资领域政策兼顾保护农业生产、稳定农资市场秩序，针对化肥市场流通、价格秩序、产品质量监管建立完善监管体系，打击假冒伪劣产品，规范市场经营行为，利好正规车用尿素企业。",
          "priority": "P1",
          "source": "中研网，2026-10-09",
          "url": "",
          "date": "2026-10-09"
        },
        {
          "title": "进出口政策动态调节，保障国内供给",
          "content": "进出口相关管理政策作为国内供需平衡的补充调节手段，根据国内市场供需情况动态调节产品对外流通，保障国内农业生产物资供给稳定。",
          "priority": "P2",
          "source": "中研网，2026-10-09",
          "url": "",
          "date": "2026-10-09"
        }
      ]

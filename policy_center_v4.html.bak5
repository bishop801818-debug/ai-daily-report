      {
        "title": "准入管理",
        "content": "完善准入管理机制，建立新建项目准入评估制度和专家评审机制，严格控制新增产能，对不符合产业政策和规划布局的项目不予核准，强化事中事后监管，建立项目建设和运营评估机制，推动行业健康有序发展，防止盲目投资和重复建设"
      },
      {
        "title": "标准建设",
        "content": "建立健全行业标准体系，加快制定关键技术标准、产品标准、检测方法标准和售后服务标准，推动标准国际化和互认互通，提升中国标准在国际上的话语权和影响力，规范行业发展秩序，提升产品质量和技术水平，推动产业高质量发展，增强国际竞争力"
      }
    ],
    "impact": {
      "上游材料": "倒逼海外产能布局",
      "中游制造": "北美建厂需求增加",
      "下游应用": "美国新能源汽车市场扩张",
      "回收环节": "建立本地回收体系"
    },
    "risk": {
      "政策": "政策不确定性",
      "行业": "地缘政治风险"
    },
    "scope": "overseas",
    "industry": "材料",
    "_isDaily": false,
    "policy_nature": "规划引导类",
    "mandatory_level": "引导性",
    "strategic_level": "产业发展性",
    "strategic_desc": "推动产业链转型升级，提升产业核心竞争力",
    "impact_segments": [
      "电池制造"
    ],
    "implementation": {
      "effective_date": "即日起",
      "policy_cycle": "中期（3-5年）",
      "key_milestones": "具体节点待明确"
    },
    "impact_scope": {
      "bus": [
        "常州锂源",
        "三金锂电"
      ],
      "segments": [
        "电池制造"
      ],
      "direction": "neutral",
      "magnitude": "medium"
    },
    "key_metrics": [
      {
        "metric": "动力电池产量",
        "target": "有序增长",
        "timeline": "2026年"
      }
    ],
    "response_guide": {
      "opportunities": [
        "关注行业整合机会，通过并购提升竞争力"
      ],
      "risks": [
        "警惕产能过剩风险，避免盲目扩产",
        "关注竞争对手动向，保持竞争优势"
      ],
      "actions": [
        {
          "priority": "high",
          "task": "梳理现有业务，评估政策影响",
          "timeline": "1周内"
        },
        {
          "priority": "medium",
          "task": "研究政策细节，制定应对方案",
          "timeline": "1个月内"
        }
      ]
    }
  }
];</script>

<script>
    // ============================================================
    // 数据源：policies_source/policies_clean.json（已过滤的非政策内容）
    // ============================================================
    let allPolicies = [];
    const POLICY_JSON_URL = 'policies_source/policies_clean.json';

    // ── 加载清洗后的 policies_clean.json ──
    async function loadPoliciesJson() {
      try {
        const data = window.EMBEDDED_POLICIES;
        return Array.isArray(data) ? data : [];
      } catch (err) {
        console.error('[政策中心] policies_clean.json 加载失败:', err);
        return [];
      }
    }

    // ===== 政策性过滤器 =====
    // 仅用于剔除明显非政策的内容（项目验收/行情/年报/产品发布等）
    // 通过硬性排除后的条目直接保留，不做严格的三条件筛选
    function isGenuinePolicy(p) {
      const title = p.title || '';
      const source = p.source || p.issuer || '';
      const content = p.content || p.summary || '';

      // 硬性排除（标题命中即杀）
      const hardExclude = [
        // 项目类（非政策）
        /项目.*验收/, /验收.*项目/, /通过.*验收/, /竣工.*验收/, /环保验收/,
        /项目备案/, /环评公示/, /批前公示/, /公示期/,
        /项目开工/, /项目投产/, /项目.*建成/, /生产线建成/,
        // 产能类（非政策）
        /年加工.*万吨/, /年产能/, /年产.*万吨|吨/, /年分装/, /年处理/,
        // 价格行情类（非政策）
        /价格.*行情/, /市场价/, /现货.*报价/, /锂价.*涨/, /电池级/, /工业级/,
        /报价上涨/, /报价下跌/, /价格回调/, /价格上行/, /价格下行/,
        // 财报公告类（非政策）
        /上市公司.*公告/, /年报|半年报|季报|一季报|中报/, /业绩/, /营收/,
        /扭亏为盈/, /亏损扩大/, /净利润/,
        // 企业动态类（非政策）
        /企业.*动态/, /公司.*发布/, /推出.*产品/, /公司动态/,
        /产品上市/, /新品发布/, /技术突破/, /研发.*成功/,
        // 市场分析类（非政策）★新增
        /需求占比/, /占比达/, /产品结构/, /绿色化/, /转型升级/,
        /行业分析/, /市场分析/, /研究显示/, /报告显示/,
        /国产化率/, /利用率提升/, /纯度达/, /突破.*%/
      ];
      for (const re of hardExclude) { if (re.test(title)) return false; }

      // 来源否决
      if (/公示平台|行情,|价格,|环境信息|期货|报告大厅/.test(source)) return false;

      return true; // 通过硬性排除即保留
    }

    async function loadAllData() {
      const jsonData = await loadPoliciesJson();
      // 修复：无id字段的政策会被全部赋值为"undefined"字符串，导致弹窗内容相同
      let idCounter = 1000;
      jsonData.forEach(p => {
        p._isDaily = false;
        if (!p.id) { p.id = 'daily_' + (idCounter++); }
        else { p.id = String(p.id); }
        // 补全：部分政策缺少type但有scope，导致分类过滤失效
        if (!p.type && p.scope) p.type = p.scope;
      });
      // 硬性过滤：仅剔除项目验收/行情/年报等明显非政策内容
      allPolicies = jsonData.filter(p => isGenuinePolicy(p));
      // 去重：全局去重（不按月份），同核心关键词 → 只保留1条
      const seenCoreKeys = new Set();
      const dedupedPolicies = [];
      allPolicies.forEach(p => {
        const coreKey = extractCorePolicyKey(p.title).toLowerCase();
        if (!seenCoreKeys.has(coreKey)) {
          seenCoreKeys.add(coreKey);
          dedupedPolicies.push(p);
        }
      });
      allPolicies = dedupedPolicies;
      console.log('[政策中心] 加载政策数据:', jsonData.length, '条 → 过滤后', allPolicies.length, '条 → 去重后', allPolicies.length, '条');
    }

    // 提取政策标题核心关键词（用于去重）
    function extractCorePolicyKey(title) {
      if (!title) return '';
      let key = title;
      // 移除常见前缀
      key = key.replace(/^(关于|关于印发|关于发布|关于公布|关于实施)/, '');
      // 移除动词后缀
      key = key.replace(/(的通知|的公示|的发布|的公布|的实施|的意见|的批复|的复函|的回答|问答)$/, '');
      // 移除政策文件类型词（保留"规划"以便同主题去重）
      key = key.replace(/(工作方案|行动方案|实施方案|行动计划|指导意见|管理办法|实施细则|实施细则|细则|通知|办法|规定|条例|计划|纲要|标准|规范|指南|目录|清单|要点|解读)$/, '');
      // 激进去重：把所有同主题政策归为同一个key（避免同一主题多条重复）
      if (/十五五/.test(title)) {
        key = '十五五规划';
      } else if (/柴油机油|车用润滑油|润滑油/.test(title)) {
        key = '车用润滑油';
      } else if (/尿素/.test(title)) {
        key = '尿素政策';
      } else if (/新能源汽车|新能源车/.test(title)) {
        key = '新能源汽车';
      } else if (/动力电池|锂电池|锂离子电池/.test(title)) {
        key = '动力电池';
      } else if (/绿色低碳|绿色化|低碳/.test(title)) {
        key = '绿色低碳';
      } else if (/氢能|氢燃料|氢燃料电池/.test(title)) {
        key = '氢能';
      } else if (/储能/.test(title)) {
        key = '储能';
      } else if (/充电设施|充电桩|充换电/.test(title)) {
        key = '充电设施';
      } else if (/光伏|太阳能|分布式光伏/.test(title)) {
        key = '光伏';
      } else if (/风电|风力发电/.test(title)) {
        key = '风电';
      } else if (/国六|排放标准|尾气排放/.test(title)) {
        key = '排放标准';
      }
      // 移除年份和日期
      key = key.replace(/\d{4}年?\d*月?/g, '');
      // 移除数字百分比
      key = key.replace(/\d+%/g, '');
      // 简化空格
      key = key.replace(/\s+/g, '').trim();
      return key || title;
    }

    // ===== State =====
    let currentTypeFilter = 'all';
    let activeMonths = new Set();
    let activeBUs = new Set();
    let lastFilterKey = ''; // 记录上一次筛选条件，用于判断是否重置分页

    // 获取当前筛选条件的key，用于判断是否变化
    function getFilterKey() {
        return currentTypeFilter + '|' + [...activeMonths].sort().join(',') + '|' + [...activeBUs].sort().join(',');
    }

    const ALL_BUS = ['常州锂源', '龙蟠时代', '法恩莱特', '三金锂电', '山东美多', '铂源催化',
                     '可兰素', '润滑油', '迪克化学'];

    // ===== Init =====
    function initSidebar() {
        // Stats：按type统计
        const total     = allPolicies.length;
        const central   = allPolicies.filter(p => p.type === 'central').length;
        const local     = allPolicies.filter(p => p.type === 'local').length;
        const overseas  = allPolicies.filter(p => p.type === 'overseas').length;
        document.getElementById('stat-total').textContent    = total;
        document.getElementById('stat-central').textContent  = central;
        document.getElementById('stat-local').textContent    = local;
        document.getElementById('stat-overseas').textContent = overseas;

        // Month nav：从 allPolicies 收集，仅保留2026-04及以后的月份，标签含年份
        const monthCounts = {};
        allPolicies.forEach(p => {
            const m = (p.date || '').substring(0, 7);
            if (m && m >= '2026-04') monthCounts[m] = (monthCounts[m] || 0) + 1;
        });
        const sortedMonths = Object.keys(monthCounts).sort((a, b) => b.localeCompare(a));
        const monthNav = document.getElementById('month-nav');
        monthNav.innerHTML = sortedMonths.map(m => {
            // 格式："2026-06" → "2026年6月"
            const [year, month] = m.split('-');
            const label = `${year}年${month}月`;
            return `<button class="month-btn" data-month="${m}">${label}</button>`;
        }).join('');
        sortedMonths.forEach(m => activeMonths.add(m));

        // BU filter（去掉"事业部"后缀做标准化匹配）
        const buSet = new Set();
        allPolicies.forEach(p => (p.bu || []).forEach(b => buSet.add(b.replace(/事业部$/, ''))));
        const buList = document.getElementById('bu-list');
        buList.innerHTML = ALL_BUS.map(bu => `
            <div class="bu-item" data-bu="${bu}">
                <input type="checkbox" id="bu-${bu}" ${buSet.has(bu)?'':'checked'}>
                <label for="bu-${bu}">${bu}</label>
            </div>
        `).join('');
        ALL_BUS.forEach(bu => { if (buSet.has(bu)) activeBUs.add(bu); });

        // Month nav click
        document.getElementById('month-nav').addEventListener('click', e => {
            const btn = e.target.closest('.month-btn');
            if (!btn) return;
            const month = btn.dataset.month;
            const marker = document.querySelector(`.month-marker[data-month="${month}"]`);
            if (marker) {
                marker.scrollIntoView({ behavior: 'smooth', block: 'start' });
                document.querySelectorAll('.month-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }
        });

        // BU filter change
        document.getElementById('bu-list').addEventListener('change', e => {
            if (e.target.type !== 'checkbox') return;
            const bu = e.target.closest('.bu-item').dataset.bu;
            if (e.target.checked) activeBUs.add(bu);
            else activeBUs.delete(bu);
            renderTimeline();
        });
    }

    // ===== Render =====
    // 分页加载配置
    const POLICY_PAGE_SIZE = 15;
    let displayedPolicyCount = POLICY_PAGE_SIZE;

    function loadMorePolicies() {
        displayedPolicyCount += POLICY_PAGE_SIZE;
        renderTimeline();
    }

    function renderTimeline() {
        const timeline = document.getElementById('timeline');
        // 按时间从新到旧排序
        const sorted = [...allPolicies].sort((a, b) => b.date.localeCompare(a.date));

        // Filter
        let filtered = sorted.filter(p => {
            if (currentTypeFilter !== 'all' && p.type !== currentTypeFilter) return false;
            const month = (p.date || '').substring(0, 7);
            if (!activeMonths.has(month)) return false;
            const buList = p.bu || [];
            if (buList.length > 0) {
                const hasMatchingBU = buList.some(b => activeBUs.has(b.replace(/事业部$/, '')));
                if (!hasMatchingBU) return false;
            }
            return true;
        });

        // 重置分页计数（当筛选条件变化时）
        if (lastFilterKey !== getFilterKey()) {
            displayedPolicyCount = POLICY_PAGE_SIZE;
        }
        lastFilterKey = getFilterKey();

        document.getElementById('topbar-count').textContent = `已显示 ${Math.min(displayedPolicyCount, filtered.length)} / ${filtered.length} 条政策`;

        if (filtered.length === 0) {
            timeline.innerHTML = `
                <div class="empty-state">
                    <div class="icon">📭</div>
                    <p>暂无符合条件的政策</p>
                </div>`;
            return;
        }

        // 按月份分组渲染，月份分隔线 = month-marker，供侧边栏月份按钮滚动定位
        let html = '';
        const displayList = filtered.slice(0, displayedPolicyCount);
        let currentMonth = null;
        displayList.forEach(p => {
            const month = (p.date || '').substring(0, 7);
            if (month !== currentMonth) {
                currentMonth = month;
                const [year, mon] = month.split('-');
                html += `<div class="month-marker" data-month="${month}"><span class="month-marker-label">${year}年${mon}月</span></div>`;
            }
            const typeLabel = p.type === 'central' ? '国家政策' : p.type === 'local' ? '地方政策' : '海外政策';
            const isDaily  = p._isDaily;
            const dailyBadge = isDaily
              ? '<span class="badge bu" style="background:#e0f2fe;color:#0277bd;border:1px solid #0277bd44;">早报补充</span>'
              : '';
            // onclick 统一用字符串ID
            html += `
                <div class="timeline-item" onclick="showModal('${p.id}')">
                    <div class="item-card">
                        <div class="item-header">
                            <span class="item-date">${p.date || ''}</span>
                            <div class="item-badges">
                                <span class="badge ${p.type}">${typeLabel}</span>
                                ${(p.bu || []).slice(0, 2).map(b => `<span class="badge bu">${b}</span>`).join('')}
                                ${dailyBadge}
                            </div>
                            <button class="collect-btn ${isCollected(p.id) ? 'collected' : ''}"
                                onclick="event.stopPropagation(); toggleCollect('${p.id}')"
                                title="${isCollected(p.id) ? '取消收藏' : '收藏'}">
                                ${isCollected(p.id) ? '★' : '☆'}
                            </button>
                        </div>
                        <div class="item-title">${(p.title || '').substring(0, 80)}</div>
                        <div class="item-summary">${(p.summary || '').substring(0, 120)}</div>
                        <div class="item-meta">${p.issuer || p.source || ''}</div>
                    </div>
                </div>`;
        });

        // 分页加载：显示"加载更多"按钮
        const totalFiltered = filtered.length;
        if (displayedPolicyCount < totalFiltered) {
            const moreCount = Math.min(displayedPolicyCount + POLICY_PAGE_SIZE, totalFiltered);
            html += `
                <div style="text-align:center;padding:24px;">
                    <button onclick="loadMorePolicies()" 
                        style="background:#f0f0f0;border:none;padding:12px 32px;border-radius:20px;cursor:pointer;font-size:14px;color:#666;">
                        ▼ 点击加载更多政策（已显示 ${moreCount} / ${totalFiltered} 条）
                    </button>
                </div>`;
        } else if (totalFiltered > POLICY_PAGE_SIZE) {
            html += `
                <div style="text-align:center;padding:24px;color:#999;font-size:13px;">
                    ─ 已加载全部 ${totalFiltered} 条政策 ─
                </div>`;
        }

        timeline.innerHTML = html;
    }

    // ===== 收藏功能（localStorage 持久化）=====
    const COLLECT_KEY = 'toolbox_collections';

    function getCollections() {
        try { return JSON.parse(localStorage.getItem(COLLECT_KEY) || '[]'); }
        catch(e) { return []; }
    }

    function isCollected(id) {
        return getCollections().some(function(x){ return x.id === 'policy_' + String(id); });
    }

    function toggleCollect(id) {
        const key = 'policy_' + String(id);
        const policy = allPolicies.find(function(p){ return String(p.id) === String(id); });
        if (!policy) return;
        let list = getCollections();
        const idx = list.findIndex(function(x){ return x.id === key; });
        if (idx >= 0) {
            list.splice(idx, 1);
            showToast('已取消收藏');
        } else {
            list.unshift({
                id: key,
                type: 'policy',
                title: policy.title || '',
                date: policy.date || '',
                source: policy.issuer || policy.source || '',
                savedAt: new Date().toISOString()
            });
            showToast('已添加到收藏');
        }
        localStorage.setItem(COLLECT_KEY, JSON.stringify(list));
        // 更新按钮状态
        document.querySelectorAll('.collect-btn').forEach(function(btn){
            var m = btn.getAttribute('onclick');
            if (m && m.includes(String(id))) {
                btn.textContent = isCollected(id) ? '★' : '☆';
                btn.classList.toggle('collected', isCollected(id));
            }
        });
    }

    function showToast(msg) {
        var t = document.getElementById('toast');
        if (!t) {
            t = document.createElement('div');
            t.id = 'toast';
            t.style.cssText = 'position:fixed;bottom:30px;left:50%;transform:translateX(-50%) translateY(20px);background:#1e3c72;color:white;padding:12px 24px;border-radius:10px;font-size:14px;font-weight:600;box-shadow:0 4px 20px rgba(30,60,114,0.3);opacity:0;transition:all 0.3s;z-index:9999;pointer-events:none;';
            document.body.appendChild(t);
        }
        t.textContent = msg;
        t.style.opacity = '1';
        t.style.transform = 'translateX(-50%) translateY(0)';
        clearTimeout(t._timer);
        t._timer = setTimeout(function(){
            t.style.opacity = '0';
            t.style.transform = 'translateX(-50%) translateY(20px)';
        }, 2500);
    }

    // ===== Modal =====
    function showModal(id) {
        // 统一用字符串比较
        const policy = allPolicies.find(p => String(p.id) === String(id));
        if (!policy) return;

        const hasDetail = policy.core && policy.core.length > 0;

        const coreHtml = hasDetail
          ? policy.core.map((c, i) => `
            <div class="core-item">
                <div class="core-phrase">核心要点${i+1}：${c.title || ''}</div>
                <div class="core-explain">${c.content || ''}</div>
            </div>`).join('')
          : '<div style="color:var(--text-dim);font-size:13px;padding:8px 0;">（来自早报，暂无详细核心要点）</div>';

        // 政策定位：优先使用新版 vertical/horizontal，其次使用旧版 policy_positioning
        const posHtml = (function() {
            if (!hasDetail) return '';
            
            let html = '';
            
            // 1. 政策属性
            if (policy.policy_nature) {
                html += `<div class="pos-block">
                    <div class="pos-heading">📌 政策属性</div>
                    <div class="pos-text">${policy.policy_nature} · ${policy.mandatory_level || ''}</div>
                </div>`;
            }
            
            // 2. 战略层级
            if (policy.strategic_level) {
                html += `<div class="pos-block">
                    <div class="pos-heading">🎯 战略层级</div>
                    <div class="pos-text">${policy.strategic_level}</div>
                    ${policy.strategic_desc ? `<div class="pos-desc">${policy.strategic_desc}</div>` : ''}
                </div>`;
            }
            
            // 3. 影响环节
            if (policy.impact_segments && policy.impact_segments.length > 0) {
                html += `<div class="pos-block">
                    <div class="pos-heading">🔗 影响环节</div>
                    <div class="pos-tags">${policy.impact_segments.map(s => `<span class="pos-tag">${s}</span>`).join('')}</div>
                </div>`;
            }
            
            // 4. 实施节奏
            if (policy.implementation) {
                html += `<div class="pos-block">
                    <div class="pos-heading">⏱️ 实施节奏</div>
                    <div class="pos-item">生效时间：${policy.implementation.effective_date || '即日起'}</div>
                    <div class="pos-item">政策周期：${policy.implementation.policy_cycle || '中期（3-5年）'}</div>
                    ${policy.implementation.key_milestones ? `<div class="pos-item">关键节点：${policy.implementation.key_milestones}</div>` : ''}
                </div>`;
            }
            
            return html;
        })();

        // 政策影响（3维度）
        const impactHtml = (function() {
            if (!hasDetail) return '';
            
            let html = '';
            
            // 1. 影响范围
            if (policy.impact_scope) {
                html += `<div style="margin-bottom:12px;">
                    <div style="font-size:13px;font-weight:700;color:var(--text-mid);margin-bottom:6px;">📍 影响范围</div>`;
                
                // 受影响BU
                if (policy.impact_scope.bus && policy.impact_scope.bus.length > 0) {
                    html += `<div style="font-size:12px;color:var(--text);margin-bottom:4px;">受影响BU：${policy.impact_scope.bus.map(b => `<span style="padding:2px 8px;background:#E8F5E9;color:#2E7D32;border-radius:3px;margin-right:4px;font-size:11px;">${b}</span>`).join(' ')}</div>`;
                }
                
                // 受影响环节
                if (policy.impact_scope.segments && policy.impact_scope.segments.length > 0) {
                    html += `<div style="font-size:12px;color:var(--text);margin-bottom:4px;">受影响环节：${policy.impact_scope.segments.map(s => `<span style="padding:2px 8px;background:#E3F2FD;color:#1565C0;border-radius:3px;margin-right:4px;font-size:11px;">${s}</span>`).join(' ')}</div>`;
                }
                
                // 影响方向和程度
                const directionIcon = {'positive': '↑', 'negative': '↓', 'neutral': '→'}[policy.impact_scope.direction] || '→';
                const directionText = {'positive': '正面', 'negative': '负面', 'neutral': '中性'}[policy.impact_scope.direction] || '中性';
                const magnitudeText = {'high': '高', 'medium': '中', 'low': '低'}[policy.impact_scope.magnitude] || '中';
                
                html += `<div style="font-size:12px;color:var(--text-mid);">影响方向：${directionIcon} ${directionText} | 影响程度：${magnitudeText}</div>`;
                
                html += `</div>`;
            }
            
            // 2. 核心指标
            if (policy.key_metrics && policy.key_metrics.length > 0) {
                html += `<div style="margin-bottom:12px;">
                    <div style="font-size:13px;font-weight:700;color:var(--text-mid);margin-bottom:6px;">📊 核心指标</div>`;
                
                policy.key_metrics.forEach(m => {
                    html += `<div style="padding:4px 8px;background:var(--surface1);border-radius:4px;margin-bottom:4px;font-size:12px;">
                        <span style="font-weight:600;color:var(--text-mid);">${m.metric}</span>
                        <span style="color:var(--primary);margin-left:6px;">→ ${m.target}</span>
                        ${m.timeline ? `<span style="color:var(--text-dim);font-size:11px;margin-left:6px;">（${m.timeline}）</span>` : ''}
                    </div>`;
                });
                
                html += `</div>`;
            }
            
            // 3. 应对建议
            if (policy.response_guide) {
                html += `<div style="margin-bottom:8px;">
                    <div style="font-size:13px;font-weight:700;color:var(--text-mid);margin-bottom:6px;">💡 应对建议</div>`;
                
                // 机会
                if (policy.response_guide.opportunities && policy.response_guide.opportunities.length > 0) {
                    html += `<div style="font-size:12px;color:var(--text);margin-bottom:4px;">💰 机会：${policy.response_guide.opportunities.map(o => `<span style="margin-right:8px;">• ${o}</span>`).join('')}</div>`;
                }
                
                // 风险
                if (policy.response_guide.risks && policy.response_guide.risks.length > 0) {
                    html += `<div style="font-size:12px;color:var(--text);margin-bottom:4px;">⚠️ 风险：${policy.response_guide.risks.map(r => `<span style="margin-right:8px;">• ${r}</span>`).join('')}</div>`;
                }
                
                // 行动
                if (policy.response_guide.actions && policy.response_guide.actions.length > 0) {
                    html += `<div style="font-size:12px;color:var(--text-mid);margin-top:6px;">📋 行动：</div>`;
                    policy.response_guide.actions.forEach(a => {
                        const priorityColor = {'high': '#F44336', 'medium': '#FF9800', 'low': '#4CAF50'}[a.priority] || '#FF9800';
                        const priorityText = {'high': '高', 'medium': '中', 'low': '低'}[a.priority] || '中';
                        html += `<div style="padding:4px 8px;border-left:3px solid ${priorityColor};margin:4px 0;font-size:12px;">
                            <span style="padding:1px 6px;background:${priorityColor}20;color:${priorityColor};border-radius:3px;font-size:11px;margin-right:6px;">${priorityText}</span>
                            <span>${a.task}</span>
                            ${a.timeline ? `<span style="color:var(--text-dim);font-size:11px;margin-left:6px;">（${a.timeline}）</span>` : ''}
                        </div>`;
                    });
                }
                
                html += `</div>`;
            }
            
            return html;
        })();

        const riskHtml = (hasDetail && policy.risk)
          ? `<div class="risk-item"><div class="risk-header"><span class="risk-dot">⚠️</span><span class="risk-name">政策推进风险</span></div><div class="risk-body">${policy.risk.policy || ''}</div></div>
             <div class="risk-item"><div class="risk-header"><span class="risk-dot">⚠️</span><span class="risk-name">产业链风险</span></div><div class="risk-body">${policy.risk.industry || ''}</div></div>`
          : '';

        const srcBadge = policy._isDaily
          ? '<span style="background:#e0f2fe;color:#0277bd;padding:3px 9px;border-radius:6px;font-size:12px;font-weight:600;margin-left:8px;"> 早报补充</span>'
          : '';

        // 适用主体
        const applicableEntities = (policy.applicable_entities && policy.applicable_entities.length > 0)
          ? policy.applicable_entities.map(e => `<span class="badge bu" style="margin-bottom:4px">${e}</span>`).join(' ')
          : '<span style="color:var(--text-dim);font-size:13px">（未识别）</span>';

        // 覆盖范围badge颜色
        const coverageMap = { '全国': '#dbeafe;#1d4ed8', '省级': '#dcfce7;#15803d', '市级': '#fef9c3;#a16207', '区级': '#fef3c7;#b45309', '县级': '#fce7f3;#9d174d', '海外': '#f3e8ff;#6b21a8' };
        const covStyle = coverageMap[policy.coverage] || '#f1f5f9;#64748b';
        const [covBg, covColor] = covStyle.split(';');
        const coverageBadge = policy.coverage
          ? `<span style="background:${covBg};color:${covColor};padding:3px 10px;border-radius:6px;font-size:12px;font-weight:700;margin-left:6px">${policy.coverage}</span>`
          : '';

        document.getElementById('modal-title').textContent = policy.title || '';
        document.getElementById('modal-body').innerHTML = `
            <div class="info-grid">
                <div class="info-card">
                    <div class="info-card-header"><span class="info-card-icon">📅</span><span class="info-card-title">基本信息</span>${srcBadge}</div>
                    <p style="margin-bottom:8px"><strong style="color:var(--text-mid)">发布时间：</strong>${policy.date || ''} ${coverageBadge}</p>
                    <p style="margin-bottom:8px"><strong style="color:var(--text-mid)">发布主体：</strong>${policy.issuer || policy.source || '（来源不明）'}</p>
                    <p><strong style="color:var(--text-mid)">涉及BU：</strong>${(policy.bu || []).join('、')}</p>
                </div>
                <div class="info-card">
                    <div class="info-card-header"><span class="info-card-icon"></span><span class="info-card-title">政策摘要</span></div>
                    <p style="font-size:14px;color:var(--text-mid);line-height:1.8">${policy.summary || policy.content || ''}</p>
                </div>
            </div>
            ${applicableEntities !== '<span style="color:var(--text-dim);font-size:13px">（未识别）</span>' ? `
            <div class="info-card" style="margin-bottom:16px;background:linear-gradient(135deg,#fffbeb,#fefce8);border:1px solid #fde68a">
                <div class="info-card-header" style="border-bottom-color:#fde68a"><span class="info-card-icon"></span><span class="info-card-title orange">适用主体</span></div>
                <div style="display:flex;flex-wrap:wrap;gap:6px;padding-top:4px">${applicableEntities}</div>
            </div>` : ''}
            <div style="display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap">
                ${policy.url && policy.url !== '#' ? `<a href="${policy.url}" target="_blank" class="original-link">📄 查看原文</a>` : ''}
                <a href="#" class="media-link" onclick="event.preventDefault();"> 媒体报道</a>
            </div>
            <div class="info-card" style="margin-bottom:16px">
                <div class="info-card-header"><span class="info-card-icon">📌</span><span class="info-card-title green">核心要点</span></div>
                ${coreHtml}
            </div>
            ${posHtml ? `<div class="info-card" style="margin-bottom:16px">
                <div class="info-card-header"><span class="info-card-icon">🎯</span><span class="info-card-title">政策定位</span></div>
                ${posHtml}
            </div>` : ''}
            ${impactHtml ? `<div class="info-card" style="margin-bottom:16px">
                <div class="info-card-header"><span class="info-card-icon">💥</span><span class="info-card-title orange">政策影响</span></div>
                ${impactHtml}
            </div>` : ''}
            ${riskHtml ? `<div class="info-card">
                <div class="info-card-header"><span class="info-card-icon"></span><span class="info-card-title red">风险控制</span></div>
                ${riskHtml}
            </div>` : ''}`;

        document.getElementById('modal-overlay').classList.add('active');
        document.getElementById('modal').classList.add('active');
    }

    function closeModal() {
        document.getElementById('modal-overlay').classList.remove('active');
        document.getElementById('modal').classList.remove('active');
    }

    // ===== Event listeners =====
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentTypeFilter = btn.dataset.filter;
            renderTimeline();
        });
    });

    document.getElementById('modal-close').addEventListener('click', closeModal);
    document.getElementById('modal-overlay').addEventListener('click', closeModal);

    // ===== Start =====
    (async function start() {
        await loadAllData();
        if (allPolicies.length === 0) {
            document.getElementById('timeline').innerHTML = '<div class="empty-state"><div class="icon">📭</div><p>未找到政策数据</p></div>';
            return;
        }
        initSidebar();
        renderTimeline();
    })();
    </script>


    <script src="assets/ai_fab_inject.js"></script>

    <!-- ===== 右下角悬浮按钮组 ===== -->
    <div id="fab-group" style="position:fixed; bottom:30px; right:30px; display:flex; flex-direction:column; gap:10px; z-index:9999;">
        <!-- 维度切换按钮 -->
        <div id="dim-filters" style="display:flex; gap:8px; opacity:0; pointer-events:none; transition:all 0.3s ease; transform:translateY(20px);">
            <button class="dim-btn active" data-filter="all" title="全部政策">全部</button>
            <button class="dim-btn" data-filter="central" title="国家政策">国家政策</button>
            <button class="dim-btn" data-filter="local" title="地方政策">地方政策</button>
            <button class="dim-btn" data-filter="overseas" title="海外政策">海外政策</button>
        </div>
        <!-- 返回顶部按钮 -->
        <div id="back-to-top-fab" title="返回顶部" style="width:50px; height:50px; background:linear-gradient(135deg, #00A86B, #007D4E); color:#fff; border-radius:50%; box-shadow:0 4px 12px rgba(0,125,78,0.4); cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:24px; transition:all 0.3s ease; opacity:0; pointer-events:none; transform:translateY(20px);">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
        </div>
    </div>

    <style>
    .dim-btn { padding:8px 14px; border:2px solid var(--border); background:var(--surface); border-radius:20px; cursor:pointer; font-size:13px; font-weight:600; transition:all 0.2s; color:var(--text); }
    .dim-btn:hover { border-color:var(--accent); color:var(--accent); }
    .dim-btn.active { background:var(--accent); color:white; border-color:var(--accent); }
    </style>

    <script>
    // 右下角悬浮按钮组逻辑
    (function() {
        var fabGroup = document.getElementById('fab-group');
        var dimFilters = document.getElementById('dim-filters');
        var backToTopFab = document.getElementById('back-to-top-fab');
        var isScrolled = false;

        // 监听滚动事件
        window.addEventListener('scroll', function() {
            var scrollY = window.pageYOffset || document.documentElement.scrollTop;
            if (scrollY > 400) {
                if (!isScrolled) {
                    dimFilters.style.opacity = '1';
                    dimFilters.style.pointerEvents = 'auto';
                    dimFilters.style.transform = 'translateY(0)';
                    backToTopFab.style.opacity = '1';
                    backToTopFab.style.pointerEvents = 'auto';
                    backToTopFab.style.transform = 'translateY(0)';
                    isScrolled = true;
                }
            } else {
                if (isScrolled) {
                    dimFilters.style.opacity = '0';
                    dimFilters.style.pointerEvents = 'none';
                    dimFilters.style.transform = 'translateY(20px)';
                    backToTopFab.style.opacity = '0';
                    backToTopFab.style.pointerEvents = 'none';
                    backToTopFab.style.transform = 'translateY(20px)';
                    isScrolled = false;
                }
            }
        });

        // 返回顶部按钮点击
        backToTopFab.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // 维度切换按钮点击
        document.querySelectorAll('.dim-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                // 同步顶部filter-bar的按钮状态
                document.querySelectorAll('.filter-btn').forEach(function(b) {
                    b.classList.remove('active');
                    if (b.dataset.filter === btn.dataset.filter) {
                        b.classList.add('active');
                    }
                });
                // 同步底部dim-btn的按钮状态
                document.querySelectorAll('.dim-btn').forEach(function(b) {
                    b.classList.remove('active');
                });
                btn.classList.add('active');
                // 更新筛选并渲染
                currentTypeFilter = btn.dataset.filter;
                renderTimeline();
                // 滚动到时间线区域
                var timeline = document.getElementById('timeline');
                if (timeline) {
                    timeline.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    })();
    </script>


</body>
</html>

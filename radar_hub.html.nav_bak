<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>雷达看板 - 龙蟠科技</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: "Microsoft YaHei", "PingFang SC", sans-serif; background: #f0f2f5; min-height: 100vh; }

        .page-header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 24px 40px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 12px rgba(30,60,114,0.3);
        }
        .page-header .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            font-size: 14px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: color 0.2s;
        }
        .page-header .back-btn:hover { color: white; }
        .page-header h1 { font-size: 22px; font-weight: bold; margin-bottom: 4px; }
        .page-header .subtitle { font-size: 13px; opacity: 0.85; }

        .container { max-width: 1100px; margin: 30px auto; padding: 0 20px; }

        .section-label {
            font-size: 13px;
            color: #888;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .section-label::after { content: ""; flex: 1; height: 1px; background: #ddd; }

        .dept-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 36px; }

        .dept-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            border-left: 4px solid #1e3c72;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            text-decoration: none;
            color: inherit;
            display: block;
        }
        .dept-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(30,60,114,0.15);
        }
        .dept-card.lithium { border-left-color: #1e3c72; }
        .dept-card.longpan { border-left-color: #2e75b6; }
        .dept-card.other { border-left-color: #7030a0; }

        .dept-card-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }
        .dept-logo {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: contain;
            background: #fff;
            border: 2px solid rgba(0,0,0,0.08);
            flex-shrink: 0;
        }
        .dept-info { flex: 1; min-width: 0; }
        .dept-name { font-size: 16px; font-weight: bold; color: #1e3c72; margin-bottom: 2px; }
        .dept-subtitle { font-size: 12px; color: #888; }

        /* ECharts 雷达图容器 */
        .dept-radar-preview {
            height: 145px;
            margin: 8px 0 4px;
        }
        .dept-radar-preview canvas { border-radius: 8px; }

        .dept-score {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 8px;
            padding-top: 10px;
            border-top: 1px solid #f0f0f0;
        }
        .dept-score-label { font-size: 12px; color: #888; }
        .dept-score-val { font-size: 20px; font-weight: bold; color: #1e3c72; }
        .dept-score-dims { font-size: 11px; color: #aaa; margin-left: 6px; }

        .dept-dims-row {
            display: flex;
            gap: 4px;
            margin-top: 6px;
            flex-wrap: wrap;
        }
        .dim-chip {
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            background: #f0f0f0;
            color: #666;
        }
        .dim-chip .chip-val { font-weight: bold; margin-right: 2px; }

        .dept-current-badge {
            display: inline-block;
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            background: #fff3e0;
            color: #e67e22;
            font-weight: bold;
            margin-left: 6px;
        }

        .footer-note {
            text-align: center;
            color: #bbb;
            font-size: 12px;
            padding: 24px;
            border-top: 1px solid #eee;
            margin-top: 20px;
        }
        .footer-note a { color: #1e3c72; text-decoration: none; font-weight: 600; }
        .footer-note a:hover { text-decoration: underline; }

        @media (max-width: 768px) {
            .dept-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<div class="page-header">
    <a class="back-btn" href="index_v3.html">← 返回首页</a>
    <h1>🕸️ 雷达看板</h1>
    <div class="subtitle">九大事业部六维雷达图分析 · 点击查看详情</div>
</div>

<div class="container">
    <div class="section-label">锂电系事业部</div>
    <div class="dept-grid" id="grid-lithium"></div>

    <div class="section-label">非锂电事业部</div>
    <div class="dept-grid" id="grid-other"></div>
</div>

<div class="footer-note">
    数据仅供参考 · <a href="index_v3.html">返回首页</a>
</div>

<script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
<script>
// ─────────────────────────────────────────────
// BU 元数据
// ─────────────────────────────────────────────
var BU_META = {
    czly: { name: '常州锂源', subtitle: '磷酸铁锂正极材料', category: 'lithium', color: '#1e3c72' },
    lpsd: { name: '龙蟠时代', subtitle: '碳酸锂', category: 'lithium', color: '#2e75b6' },
    felt: { name: '法恩莱特', subtitle: '电解液', category: 'lithium', color: '#7b2d8b' },
    sdmd: { name: '山东美多', subtitle: '动力电池回收', category: 'lithium', color: '#215732' },
    sjld: { name: '三金锂电', subtitle: '三元前驱体', category: 'lithium', color: '#34495e' },
    kls:  { name: '可兰素', subtitle: '车用尿素', category: 'other', color: '#d35400' },
    lhy:  { name: '润滑油事业部', subtitle: '润滑油', category: 'other', color: '#c0392b' },
    bych: { name: '铂源催化', subtitle: '氢能/催化', category: 'other', color: '#8e44ad' },
    dhx:  { name: '迪克化学', subtitle: '汽车化学品', category: 'other', color: '#16a085' },
};

// 六维 dims 数据（与 radar_detail.html 一致）
var BU_DIMS = {
    czly: { d1: 87, d2: 90, d3: 82, d4: 80, d5: 90, d6: 78 },
    lpsd: { d1: 75, d2: 72, d3: 88, d4: 65, d5: 70, d6: 82 },
    felt: { d1: 82, d2: 88, d3: 85, d4: 78, d5: 85, d6: 80 },
    sdmd: { d1: 90, d2: 90, d3: 82, d4: 80, d5: 90, d6: 78 }, // 真实数据
    sjld: { d1: 78, d2: 80, d3: 72, d4: 75, d5: 78, d6: 70 },
    kls:  { d1: 85, d2: 88, d3: 90, d4: 85, d5: 82, d6: 88 },
    lhy:  { d1: 80, d2: 82, d3: 78, d4: 80, d5: 75, d6: 78 },
    bych: { d1: 68, d2: 65, d3: 70, d4: 62, d5: 60, d6: 65 },
    dhx:  { d1: 75, d2: 78, d3: 72, d4: 70, d5: 72, d6: 75 },
};

// 标记当前月份BU（★）
var BU_IS_CURRENT = { sdmd: true }; // 山东美多有真实当前数据

var BU_LOGOS = {};
var buChartInstances = {}; // 缓存每个BU的 ECharts 实例

var DIM_NAMES = ['核心考核', '经营效益', '运营效率', '技术创新', '风险合规', '组织活力'];
var DIM_IDS = ['d1', 'd2', 'd3', 'd4', 'd5', 'd6'];

// ─────────────────────────────────────────────
// 加载 logo
// ─────────────────────────────────────────────
(function loadLogos() {
    fetch('bu_logos.json')
        .then(function(r) { return r.json(); })
        .then(function(logos) {
            BU_LOGOS = logos;
            renderCards();
        })
        .catch(function() {
            renderCards();
        });
})();

// ─────────────────────────────────────────────
// 工具函数
// ─────────────────────────────────────────────
function getScore(dims) {
    var vals = DIM_IDS.map(function(d) { return dims[d] || 0; });
    return Math.round(vals.reduce(function(a, b) { return a + b; }, 0) / vals.length);
}

// ─────────────────────────────────────────────
// 渲染卡片 HTML（雷达图容器使用真实 ECharts div）
// ─────────────────────────────────────────────
function buildCard(buId, meta) {
    var dims = BU_DIMS[buId] || { d1: 0, d2: 0, d3: 0, d4: 0, d5: 0, d6: 0 };
    var score = getScore(dims);
    var logo = BU_LOGOS[buId] || '';
    var logoHTML = logo
        ? '<img class="dept-logo" src="' + logo + '" alt="' + meta.name + '" onerror="this.style.display=\'none\'">'
        : '<div class="dept-logo" style="background:#f0f0f0;display:flex;align-items:center;justify-content:center;font-size:20px;">📊</div>';

    var currentBadge = BU_IS_CURRENT[buId]
        ? '<span class="dept-current-badge">★当月</span>'
        : '';

    var dimChips = DIM_IDS.map(function(d, i) {
        var v = dims[d] || 0;
        return '<span class="dim-chip"><span class="chip-val" style="color:' + meta.color + '">' + v + '</span>' + DIM_NAMES[i] + '</span>';
    }).join('');

    return '<a class="dept-card ' + meta.category + '" href="radar_detail.html?id=' + buId + '" style="border-left-color:' + meta.color + '">' +
        '<div class="dept-card-header">' +
        logoHTML +
        '<div class="dept-info">' +
        '<div class="dept-name" style="color:' + meta.color + '">' + meta.name + currentBadge + '</div>' +
        '<div class="dept-subtitle">' + meta.subtitle + '</div>' +
        '</div></div>' +
        '<div class="dept-radar-preview" id="radar-' + buId + '"></div>' +
        '<div class="dept-dims-row">' + dimChips + '</div>' +
        '<div class="dept-score">' +
        '<span class="dept-score-label">综合评分</span>' +
        '<span><span class="dept-score-val" style="color:' + meta.color + '">' + score + '</span><span class="dept-score-dims">/100</span></span>' +
        '</div></a>';
}

function renderCards() {
    var gridLithium = document.getElementById('grid-lithium');
    var gridOther = document.getElementById('grid-other');

    Object.keys(BU_META).forEach(function(buId) {
        var meta = BU_META[buId];
        var card = buildCard(buId, meta);
        if (meta.category === 'lithium') {
            gridLithium.innerHTML += card;
        } else {
            gridOther.innerHTML += card;
        }
    });

    // 渲染完卡片后，初始化所有 ECharts 雷达图
    initAllRadars();
}

// ─────────────────────────────────────────────
// ECharts 迷你雷达图初始化（IntersectionObserver 懒加载）
// ─────────────────────────────────────────────
function initAllRadars() {
    Object.keys(BU_META).forEach(function(buId) {
        renderMiniRadar(buId);
    });
}

function renderMiniRadar(buId) {
    var dom = document.getElementById('radar-' + buId);
    if (!dom) return;

    var meta = BU_META[buId];
    var dims = BU_DIMS[buId] || { d1: 0, d2: 0, d3: 0, d4: 0, d5: 0, d6: 0 };
    var vals = DIM_IDS.map(function(d) { return dims[d] || 0; });

    var chart = echarts.init(dom, null, { renderer: 'canvas', width: dom.clientWidth || 280, height: 145 });
    buChartInstances[buId] = chart;

    // 颜色辅助：亮色版本（用于渐变）
    var lightColor = meta.color + '99'; // 透明度60%
    var darkColor = meta.color;

    var option = {
        backgroundColor: 'transparent',
        animation: true,
        animationDuration: 800,
        animationEasing: 'cubicOut',
        tooltip: {
            trigger: 'item',
            confine: true,
            backgroundColor: 'rgba(255,255,255,0.97)',
            borderColor: meta.color,
            borderWidth: 1.5,
            borderRadius: 8,
            padding: [8, 12],
            textStyle: { color: '#333', fontSize: 12 },
            formatter: function(params) {
                var idx = params.dimensionIndex;
                var dimName = (idx != null && idx >= 0) ? (DIM_NAMES[idx] || ('维度' + (idx + 1))) : '综合评分';
                return '<b style="color:' + meta.color + ';font-size:13px">' + meta.name + '</b><br/>' +
                    '<span style="color:#888;font-size:11px">' + dimName + ':</span> ' +
                    '<b style="color:' + meta.color + ';font-size:14px">' + params.value + '</b>' +
                    '<span style="color:#888;font-size:11px"> / 100</span>';
            }
        },
        radar: {
            indicator: DIM_NAMES.map(function(n) { return { name: n, max: 100 }; }),
            radius: '62%',
            center: ['50%', '50%'],
            splitNumber: 3,
            axisName: {
                color: '#aaa',
                fontSize: 8,
                fontWeight: 'normal',
            },
            //渐变网格线（从内到外颜色变浅）
            splitLine: {
                show: true,
                lineStyle: {
                    width: 1,
                    color: {
                        type: 'linear',
                        x: 0, y: 0, x2: 0, y2: 1,
                        colorStops: [
                            { offset: 0, color: meta.color + '55' },
                            { offset: 0.5, color: meta.color + '22' },
                            { offset: 1, color: meta.color + '0a' }
                        ]
                    },
                    type: 'solid'
                }
            },
            // 渐变填充区域
            splitArea: {
                show: true,
                areaStyle: {
                    color: [
                        meta.color + '06',
                        meta.color + '0c',
                        meta.color + '14'
                    ]
                }
            },
            axisLine: {
                show: true,
                lineStyle: { color: meta.color + '66', width: 1 }
            },
            shape: 'polygon',
        },
        series: [{
            type: 'radar',
            emphasis: {
                lineStyle: { width: 3 },
                areaStyle: { opacity: 0.35 }
            },
            data: [{
                value: vals,
                name: meta.name,
                // 渐变线条
                lineStyle: {
                    color: {
                        type: 'linear',
                        x: 0, y: 0, x2: 1, y2: 1,
                        colorStops: [
                            { offset: 0, color: lightColor },
                            { offset: 1, color: darkColor }
                        ]
                    },
                    width: 2,
                    type: 'solid'
                },
                // 发光数据点
                itemStyle: {
                    color: meta.color,
                    shadowBlur: 10,
                    shadowColor: meta.color + '88'
                },
                // 径向渐变填充
                areaStyle: {
                    color: {
                        type: 'radial',
                        x: 0.5, y: 0.5, r: 0.5,
                        colorStops: [
                            { offset: 0, color: meta.color + '40' },
                            { offset: 1, color: meta.color + '0a' }
                        ]
                    }
                },
                label: { show: false },
                symbol: 'circle',
                symbolSize: 5,
            }],
        }],
    };

    chart.setOption(option);
}

//窗口 resize 时重绘所有图表
window.addEventListener('resize', function() {
    Object.keys(buChartInstances).forEach(function(buId) {
        var chart = buChartInstances[buId];
        var dom = document.getElementById('radar-' + buId);
        if (chart && dom) {
            chart.resize({ width: dom.clientWidth, height: 145 });
        }
    });
});
</script>
</body>
</html>